observation = {
  1: 1,                       ; version
  2: bstr .size 32,           ; witness id
  3: uint,                    ; sequence
  4: digest-pair / null,      ; previous lineage id
  5: int,                     ; monotonic picoseconds
  6: int,                     ; interval lower ps
  7: int,                     ; interval upper ps
  8: tstr,                    ; reference frame id
  9: [* source],
  10: digest-pair,            ; hardware state
  11: digest-pair,            ; firmware state
  12: digest-pair             ; protocol genesis id
}
source = {1:tstr,2:int,3:uint,4:tstr,5:digest-pair}
digest-pair = {1:bstr .size 32,2:bstr .size 48}
